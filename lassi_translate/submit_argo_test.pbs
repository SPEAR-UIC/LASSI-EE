#!/bin/bash
#PBS -l select=1
#PBS -l walltime=00:10:00
#PBS -l filesystems=flare
#PBS -A EE-ECP
#PBS -q debug
#PBS -N argo_api_test

# PBS Job Script for Testing Argo API Connection
# This script runs a simple test to verify Argo API connectivity
# from a compute node using the configured proxy.

echo "========================================================================"
echo "ARGO API TEST JOB"
echo "========================================================================"
echo "Job ID: $PBS_JOBID"
echo "Job Name: $PBS_JOBNAME"
echo "Hostname: $(hostname)"
echo "Start Time: $(date)"
echo "Working Directory: $PBS_O_WORKDIR"
echo "========================================================================"

# Change to the lassi_translate directory using absolute path
SCRIPT_DIR="/home/vchirio/LASSI-EE/lassi_translate"
cd "$SCRIPT_DIR" || exit 1
echo "Working in: $(pwd)"
echo ""

# Show Python version
echo "Python version:"
python3 --version
echo ""

# Show curl version (needed for API calls)
echo "Curl version:"
curl --version | head -n 1
echo ""

# Test proxy connectivity
echo "Testing proxy connectivity..."
echo "Attempting to reach Argo API endpoint through proxy..."
curl -x https://proxy.alcf.anl.gov:3128 -s -o /dev/null -w "HTTP Status: %{http_code}\n" \
     --max-time 10 https://apps-dev.inside.anl.gov/ || echo "Proxy test failed (non-fatal)"
echo ""

echo "========================================================================"
echo "Running Argo API Test Script"
echo "========================================================================"

# Run the test script
python3 test_argo_job.py
TEST_EXIT_CODE=$?

echo ""
echo "========================================================================"
echo "JOB SUMMARY"
echo "========================================================================"
echo "Test script exit code: $TEST_EXIT_CODE"
echo "End Time: $(date)"

if [ $TEST_EXIT_CODE -eq 0 ]; then
    echo "Status: SUCCESS ✓"
    echo ""
    echo "Check the detailed log in: test_outputs/argo_test_*.log"
else
    echo "Status: FAILED ✗"
    echo ""
    echo "Check the detailed log in: test_outputs/argo_test_*.log"
    echo "Also check PBS error file: argo_test_${PBS_JOBID}.err"
fi

echo "========================================================================"

# Exit with the same code as the test script
exit $TEST_EXIT_CODE
